# apps/web/.env.local — copy to apps/web/.env.local (git-ignored). Nothing here is secret:
# every NEXT_PUBLIC_ value is shipped to the browser.
NEXT_PUBLIC_API_URL=http://localhost:4000
# 1990 = QIE Mainnet, 1983 = QIE Testnet, 31337 = local anvil
NEXT_PUBLIC_CHAIN_ID=1983
# Optional: RPC URL(s) for the chain above, comma-separated (required for 31337; defaults to all public QIE RPCs otherwise)
NEXT_PUBLIC_RPC_URL=
NEXT_PUBLIC_QIEDEX_SWAP_URL=https://www.swap.dex.qie.digital/swap
