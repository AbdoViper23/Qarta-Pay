# contracts/.env — copy to contracts/.env (git-ignored). No private keys here: use
# Foundry's encrypted keystore (`cast wallet import <name> --interactive`).
QIE_MAINNET_RPC=https://rpc1mainnet.qie.digital
QIE_TESTNET_RPC=https://rpc1testnet.qie.digital

# QIE ecosystem contracts on mainnet (docs/07-QIE-REFERENCE.md)
QUSDC_ADDRESS=0x3F43DA82eC9A4f5285F10FaF1F26EcA7319E5DA5
WQIE_ADDRESS=0x0087904D95BEe9E5F24dc8852804b547981A9139
QIE_USD_FEED=0x3Bc617cF3A4Bb77003e4c556B87b13D556903D17
QIEDEX_ROUTER=0x08cd2e72e156D8563B4351eb4065C262A9f553Ef

# Treasury sweep (docs/04-SMART-CONTRACTS.md). Public address only.
TREASURY_ADDRESS=0x0000000000000000000000000000000000000000
SWEEP_AMOUNT_WEI=0
SWEEP_MAX_SLIPPAGE_BPS=700
SWEEP_GAS_RESERVE_WEI=1000000000000000000
SWEEP_MAX_ORACLE_AGE_S=86400

# Deploy (script/Deploy.s.sol). Public addresses only; the deployer signs with --account.
QUOTE_SIGNER_ADDRESS=0x0000000000000000000000000000000000000000
FULFILLER_ADDRESS=0x0000000000000000000000000000000000000000
OWNER_ADDRESS=0x0000000000000000000000000000000000000000
MAX_ORACLE_AGE_S=86400
ORACLE_TOLERANCE_BPS=1000
ORACLE_GUARD_ENABLED=true
REFUND_TIMEOUT_S=7200
# true on anvil/testnet only (deploys MockERC20 + MockAggregatorV3); refused on chain 1990
DEPLOY_MOCKS=false
