{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "api": {
      "root": "apps/api",
      "framework": "fastify",
      "entrypoint": "src/vercel.ts",
      "functions": {
        "src/vercel.ts": { "maxDuration": 300 }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/v1/jobs/run", "schedule": "0 4 * * *" }]
}
